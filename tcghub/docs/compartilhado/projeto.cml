Domain dominio {
	domainVisionStatement = "Plataforma web para comunidade, catalogo e comercio de cardgames (TCGHub)"

	Subdomain adm {
		type = CORE_DOMAIN
		domainVisionStatement = "Administrador"
	}

	Subdomain comunidade {
		type = SUPPORTING_DOMAIN
		domainVisionStatement = "Comunidade"
	}

	Subdomain loja {
		type = CORE_DOMAIN
		domainVisionStatement = "Usuario"
	}
}

BoundedContext compartilhado {
	Module compartilhado {
		Aggregate compartilhado {
			enum Autorizacao {
				ADMINISTRADOR, USUARIO
			}

			ValueObject UsuarioIdentificador {
				String valor
			}
		}
	}
}
